{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/producto/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/producto/:id(prod_[0-9]+)/:slug",
      "destination": "/producto/:id/:slug/",
      "permanent": true
    },
    {
      "source": "/producto/:id(prod_[0-9]+)",
      "destination": "/producto/:id/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/producto/:id(prod_[0-9]+)/:slug/",
      "destination": "/api/producto?id=:id&slug=:slug"
    },
    {
      "source": "/producto/:id(prod_[0-9]+)/",
      "destination": "/api/producto?id=:id"
    }
  ]
}
